# Demo defaults — API requests use the same-origin Next.js proxy.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_TIMEOUT_MS=20000

# Optional Supabase UI connection for future authenticated mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Next.js proxy target. Leave at the default for local full-stack mode.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
